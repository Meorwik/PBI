table FactSales
	lineageTag: a72159d6-8def-4d9c-988e-5e503081d3e7

	measure 'Total Sales' = SUM(FactSales[SalesAmount])
		formatString: #,0
		lineageTag: 8752a63a-affc-42e9-b87a-0ea3acbd2f31

	measure 'Total Profit' = SUM(FactSales[ProfitAmount])
		formatString: #,0
		lineageTag: 4cc0003b-8e63-4f09-adc7-469836f1df3c

	measure 'Sales Lines' = COUNTROWS(FactSales)
		lineageTag: b2b92500-fafa-4c10-91b1-71e8bb0dcf18

	measure Orders = DISTINCTCOUNT(FactSales[OrderID])
		lineageTag: ec9d5ff7-0d45-4f04-9b44-3b57e52b0215

	measure 'PK DimProduct rows | distinct' = COUNTROWS(DimProduct) & " | " & DISTINCTCOUNT(DimProduct[ProductID])
		lineageTag: 4cbe22cd-967d-4964-a1ce-2c486cdec8f0

	measure 'PK DimCustomer rows | distinct' = COUNTROWS(DimCustomer) & " | " & DISTINCTCOUNT(DimCustomer[CustomerID])
		lineageTag: 7132bac5-a022-4c34-92cb-8d5b2f23df83

	measure 'PK DimStore rows | distinct' = COUNTROWS(DimStore) & " | " & DISTINCTCOUNT(DimStore[StoreID])
		lineageTag: 5f0d2f6f-f691-4d09-87e5-cb1b286b91e2

	measure 'PK DimManager rows | distinct' = COUNTROWS(DimManager) & " | " & DISTINCTCOUNT(DimManager[ManagerID])
		lineageTag: 48dac4aa-80dd-46af-8461-a75dec857b68

	measure 'PK DimDate rows | distinct' = COUNTROWS(DimDate) & " | " & DISTINCTCOUNT(DimDate[OrderDate])
		lineageTag: 773f9c47-58fb-4e69-9472-83357d1e696b

	measure 'FK missing Product' = COUNTROWS(FILTER(FactSales, ISBLANK(RELATED(DimProduct[ProductID])))) + 0
		lineageTag: 00870a45-3ff6-47e5-a908-d53c94c64fea

	measure 'FK missing Customer' = COUNTROWS(FILTER(FactSales, ISBLANK(RELATED(DimCustomer[CustomerID])))) + 0
		lineageTag: cdf475ae-3a47-4da6-ab15-be2bf8fdfdbb

	measure 'FK missing Store' = COUNTROWS(FILTER(FactSales, ISBLANK(RELATED(DimStore[StoreID])))) + 0
		lineageTag: 8c86db6b-1e02-4286-98de-965978dd72e6

	measure 'FK missing Manager' = COUNTROWS(FILTER(FactSales, ISBLANK(RELATED(DimManager[ManagerID])))) + 0
		lineageTag: 877dca58-b399-4549-9798-76cab46083a8

	measure 'FK missing Date' = COUNTROWS(FILTER(FactSales, ISBLANK(RELATED(DimDate[OrderDate])))) + 0
		lineageTag: 24170d48-3cd8-488d-9d8a-9a1a0611c615

