table FactSales
	lineageTag: 9709de34-ff5c-49cf-8b9f-afba552e89e4

	measure 'Total Sales' = SUM(FactSales[SalesAmount])
		formatString: #,0
		lineageTag: 40372cd5-20c0-4200-b5e7-8d95093d14ca

	measure Rows = COUNTROWS(FactSales)
		lineageTag: 92d02a7f-9be3-4aac-a3d8-405a06e41159

	measure 'Check Rows' = CALCULATE(COUNTROWS(FactSales), FactSales[OrderQuality] = "Check")
		lineageTag: c9b3b0f2-3124-4166-bc0a-035d3fd9bc47

