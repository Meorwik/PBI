expression 'Преобразовать файл' =
		let
		    Источник = (Параметр1 as binary) => let
		            Источник = Excel.Workbook(Параметр1, null, true),
		            SalesTable_Table = Источник{[Item="SalesTable",Kind="Table"]}[Data]
		        in
		            SalesTable_Table
		in
		    Источник
	mAttributes: [ FunctionQueryBinding = "{""exemplarFormulaName"":""Преобразовать пример файла""}" ]
	lineageTag: 86a838e7-7ca8-4640-8088-1a63d932e1e2
