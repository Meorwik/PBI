model Model
	culture: ru-RU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: ru-RU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Модель'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Параметры'

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["pSourceFile", "FactSales", "FactReturns", "FactBudget", "DimDate", "DimCategory", "DimProduct", "DimCustomer", "DimStore", "DimStoreDetails", "DimPromotion", "BridgeProductPromotion"]

ref table FactSales
ref table FactReturns
ref table FactBudget
ref table DimDate
ref table DimCategory
ref table DimProduct
ref table DimCustomer
ref table DimStore
ref table DimStoreDetails
ref table DimPromotion
ref table BridgeProductPromotion

ref cultureInfo ru-RU
