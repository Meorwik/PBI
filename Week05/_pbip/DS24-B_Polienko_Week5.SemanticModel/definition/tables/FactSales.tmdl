table FactSales
	lineageTag: 33cb6d66-09b9-495d-8ca5-ec87e1422b73

	measure 'Total Sales' = SUM(FactSales[SalesAmount])
		formatString: #,0
		lineageTag: fb9e702e-513f-4537-a7f9-298963e3f09d

	measure 'Sales by Ship Date' = CALCULATE([Total Sales], USERELATIONSHIP(DimDate[Date], FactSales[ShipDate]))
		formatString: #,0
		lineageTag: cd0d8014-51cd-4b2e-a714-e694698cdaa4

	measure 'Ship - Order diff' = [Sales by Ship Date] - [Total Sales]
		formatString: #,0
		lineageTag: a4fda750-5fa0-49e8-893f-90cc77319143

	measure 'Total Returns' = SUM(FactReturns[ReturnAmount])
		formatString: #,0
		lineageTag: a1362c0d-2f1a-45b3-a317-f8e197a040d7

	measure 'Return Rate %' = DIVIDE([Total Returns], [Total Sales])
		formatString: 0.0%
		lineageTag: 36eeb9ac-ddf0-4970-b218-99e35b8c94ed

	measure 'Total Budget' = SUM(FactBudget[BudgetAmount])
		formatString: #,0
		lineageTag: 931b2342-7e7d-47b2-9c86-ba675163a5a7

	measure 'Sales vs Budget %' = DIVIDE([Total Sales], [Total Budget])
		formatString: 0.0%
		lineageTag: 54c67c57-ade7-41f7-8a36-cf365c500c9b

	measure 'Promo Links' = COUNTROWS(BridgeProductPromotion)
		lineageTag: 3bbc079e-9070-4735-9e6c-fa83b0f5bb5c

	measure 'Customers (Single)' = COUNTROWS(DimCustomer)
		lineageTag: c4b3065f-4d36-4e9a-9360-8ce45ada1d95

	measure 'Customers (Both via CROSSFILTER)' = CALCULATE(COUNTROWS(DimCustomer), CROSSFILTER(FactSales[CustomerID], DimCustomer[CustomerID], Both))
		lineageTag: ffc7f6e1-c0ff-4945-b117-92c792f0449b

