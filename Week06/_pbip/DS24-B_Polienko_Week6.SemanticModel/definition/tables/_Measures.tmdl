table _Measures
	lineageTag: 6a63f700-8c4b-4d88-8825-71f23a51d4cf

	measure 'Total Sales' = SUM(FactSales[SalesAmount])
		formatString: #,0
		displayFolder: 1. Базовые
		lineageTag: 3d78fd3b-ab11-43cc-96f7-d3909ad45280

	measure 'Total Profit' = SUM(FactSales[ProfitAmount])
		formatString: #,0
		displayFolder: 1. Базовые
		lineageTag: 2f99bf42-01aa-4691-825a-8d4c8cdba687

	measure 'Total Cost' = SUM(FactSales[CostAmount])
		formatString: #,0
		displayFolder: 1. Базовые
		lineageTag: f88e81ff-87b3-4869-a5e3-e2fbd1384a36

	measure 'Units Sold' = SUM(FactSales[Quantity])
		formatString: #,0
		displayFolder: 1. Базовые
		lineageTag: 8720698f-bc82-4595-bd72-686d1bf24092

	measure 'Orders Count' = DISTINCTCOUNT(FactSales[OrderID])
		formatString: #,0
		displayFolder: 1. Базовые
		lineageTag: 4136b802-e13a-4b7c-972d-e8173e7ce033

	measure 'Sales Lines' = COUNTROWS(FactSales)
		formatString: #,0
		displayFolder: 1. Базовые
		lineageTag: 34c61470-8178-442f-9dd6-b378aac83bbc

	measure 'Customers Count' = DISTINCTCOUNT(FactSales[CustomerID])
		formatString: #,0
		displayFolder: 1. Базовые
		lineageTag: ad9529c2-e3a4-4a0c-9544-f2c6bfa1fc6e

	measure 'Total Returns' = SUM(FactReturns[ReturnAmount])
		formatString: #,0
		displayFolder: 1. Базовые
		lineageTag: 276156af-3147-4435-8224-6a72ae626111

	measure 'Average Sale Row' = AVERAGE(FactSales[SalesAmount])
		formatString: #,0
		displayFolder: 2. KPI
		lineageTag: daff91c8-c92a-47fe-a622-61d271ef32e1

	measure 'Average Order Value' = DIVIDE([Total Sales], [Orders Count], 0)
		formatString: #,0
		displayFolder: 2. KPI
		lineageTag: 74d2cb5c-18cf-4f7a-9a2b-3d229cec9030

	measure 'Profit Margin %' =
			VAR SalesValue = [Total Sales]
			VAR ProfitValue = [Total Profit]
			RETURN
			    DIVIDE(ProfitValue, SalesValue, 0)
		formatString: 0.0%
		displayFolder: 2. KPI
		lineageTag: e4f91cc0-55a3-4573-9893-73add27125db

	measure 'Sales per Customer' = DIVIDE([Total Sales], [Customers Count], 0)
		formatString: #,0
		displayFolder: 2. KPI
		lineageTag: d0a643d5-75b6-44cc-8e83-4b685b3c115b

	measure 'Units per Order' = DIVIDE([Units Sold], [Orders Count], 0)
		formatString: 0.00
		displayFolder: 2. KPI
		lineageTag: 8470c1d6-291e-4b51-b361-ae060fa3828d

	measure 'Sales Recalculated' =
			SUMX(
			    FactSales,
			    FactSales[Quantity] * FactSales[UnitPrice] * (1 - FactSales[DiscountPct])
			)
		formatString: #,0
		displayFolder: 3. Итераторы
		lineageTag: 6ae3a199-d71b-4c0c-8dad-2d9ed5964571

	measure 'Average Revenue per Line' =
			AVERAGEX(
			    FactSales,
			    FactSales[Quantity] * FactSales[UnitPrice] * (1 - FactSales[DiscountPct])
			)
		formatString: #,0
		displayFolder: 3. Итераторы
		lineageTag: 4a0157e5-c917-4c6a-9096-4c0c85b9b8de

	measure 'Discount Amount' =
			SUMX(
			    FactSales,
			    FactSales[Quantity] * FactSales[UnitPrice] * FactSales[DiscountPct]
			)
		formatString: #,0
		displayFolder: 3. Итераторы
		lineageTag: 571a448d-1c1a-48d3-9a71-eba30960d0d4

	measure 'Discount Rate %' = DIVIDE([Discount Amount], [Total Sales] + [Discount Amount], 0)
		formatString: 0.0%
		displayFolder: 3. Итераторы
		lineageTag: 358fd515-b947-4188-a793-c0c6798eda8a

	measure 'Sales Status' = IF([Total Sales] >= 10000000, "Высокие продажи", "Обычные продажи")
		displayFolder: 4. Логика
		lineageTag: efc99de3-05cc-4910-933b-09c59be39b6a

	measure 'Performance Level' =
			SWITCH(
			    TRUE(),
			    [Profit Margin %] >= 0.25, "A",
			    [Profit Margin %] >= 0.15, "B",
			    [Profit Margin %] >= 0.05, "C",
			    "D"
			)
		displayFolder: 4. Логика
		lineageTag: 15130f74-066a-42d2-878b-61e0ed065afe

	measure 'Return Alert' = IF([Return Rate %] > 0.08, "Проверить возвраты", "Норма")
		displayFolder: 4. Логика
		lineageTag: cb788563-5cd9-4b69-b165-e9afac591725

	measure 'AOV Segment' =
			SWITCH(
			    TRUE(),
			    ISBLANK([Orders Count]), BLANK(),
			    [Average Order Value] >= 1000000, "Крупный чек",
			    [Average Order Value] >= 500000, "Средний чек",
			    "Малый чек"
			)
		displayFolder: 4. Логика
		lineageTag: 11613b71-684a-463d-97a4-574d1e221918

	measure 'Return Rate %' = DIVIDE([Total Returns], [Total Sales], 0)
		formatString: 0.0%
		displayFolder: 5. Возвраты и динамика
		lineageTag: 1597e10e-a8fa-44af-ad07-cbc69ca22fe7

	measure 'Sales PY' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR(DimDate[Date]))
		formatString: #,0
		displayFolder: 5. Возвраты и динамика
		lineageTag: 647bb5be-5c37-4f4b-862c-1194ae2a5f04

	measure 'Sales YoY %' =
			VAR CurrentSales = [Total Sales]
			VAR PreviousSales = [Sales PY]
			VAR Growth = CurrentSales - PreviousSales
			RETURN
			    IF(HASONEVALUE(DimDate[Year]) && NOT ISBLANK(PreviousSales), DIVIDE(Growth, PreviousSales))
		formatString: 0.0%
		displayFolder: 5. Возвраты и динамика
		lineageTag: 5ce30673-8a37-4058-bb77-204dc9820174

	column 'Служебный'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 252d6d74-f322-453d-af66-fc391c2ca060
		summarizeBy: sum
		sourceColumn: Служебный

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Источник = #table(type table [Служебный = Int64.Type], {{1}})
				in
				    Источник

	annotation PBI_ResultType = Table
