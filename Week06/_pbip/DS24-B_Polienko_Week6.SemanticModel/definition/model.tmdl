model Model
	culture: ru-RU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: ru-RU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Модель'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Параметры'

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["pSourceFile", "_Measures", "FactSales", "FactReturns", "DimProduct", "DimCustomer", "DimStore", "DimDate"]

ref table _Measures
ref table FactSales
ref table FactReturns
ref table DimProduct
ref table DimCustomer
ref table DimStore
ref table DimDate

ref cultureInfo ru-RU
